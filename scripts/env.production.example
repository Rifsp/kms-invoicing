# Contoh konfigurasi PRODUCTION KMS Invoicing (native, IP-only, tanpa TLS)
# Salin ke /opt/kms-invoicing/.env.production lalu chmod 600.
DEBUG=0
SECRET_KEY=ganti-dengan-secret-acak-panjang
POSTGRES_DB=kms_invoicing
POSTGRES_USER=kms_inv
POSTGRES_PASSWORD=ganti-dengan-password-db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
CONN_MAX_AGE=30
ALLOWED_HOSTS=103.25.223.5,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://103.25.223.5:8013,http://localhost:8013
# --- karena akses via HTTP (tanpa TLS): matikan semua paksaan HTTPS ---
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
